# Database Configuration
# Defaults to localhost XAMPP if omitted
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stylehub

# --------------------------------------------------------------------------
# SMS & WhatsApp Gateway Configurations (Optional)
# If left empty, the backend runs in realistic Simulation mode automatically.
# --------------------------------------------------------------------------

# Option A: Fast2SMS (Popular in India - https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Option B: Twilio (Global SMS & WhatsApp - https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option C: Meta WhatsApp Business Cloud API (https://developers.facebook.com)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
